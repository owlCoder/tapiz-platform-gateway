# Public domains owned by the gateway. Use real production values only on the VPS.
CADDY_EMAIL=ops@example.invalid
TAPIZ_API_DOMAIN=api.tapiz.test
AURA_API_DOMAIN=api.aura.test

# Docker networks are intentionally external. Each product owns its own network;
# only this gateway joins both of them.
TAPIZ_EDGE_NETWORK=tapiz-edge
AURA_EDGE_NETWORK=aura-edge
